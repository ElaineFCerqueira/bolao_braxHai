# Copie este arquivo para .env.local e preencha com suas credenciais do Firebase
# Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu_projeto_id
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Data/hora do início do jogo (ISO 8601 no horário de Brasília → UTC-3)
# Exemplo: jogo às 21h de Brasília = 00:00 UTC do dia seguinte
VITE_MATCH_START=2025-09-10T00:00:00Z
